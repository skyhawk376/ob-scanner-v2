# OANDA v20 practice API (optional)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Telegram (P4) — leave empty to force dry-run log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = never call Telegram API (writes data/results/telegram_dryrun.log)
TELEGRAM_DRY_RUN=true

# Start APScheduler with API (monitor + digests 07:45 / 14:15 Paris)
ENABLE_SCHEDULER=false

TZ=Europe/Paris

# Lifecycle sensitivity (P1)
# Soft reaction OFF by default → exit at +1R / opposing liquidity. Set true + SOFT_REACTION_R=0.5 to re-enable.
ENABLE_SOFT_REACTION=false
SOFT_REACTION_R=0.5
REACTION_R=1.0

# Default scan/fetch groups for pipeline & API when group= omitted (UI can still enable NQ100/ENERGIE).
# Use ALL to include every group including NQ100.
DEFAULT_SCAN_GROUPS=METAUX,FOREX,CRYPTO
# Option B: default min stars for scan pipeline & UI (1–5)
DEFAULT_MIN_SCORE=4

# Always-on host (Fly / Docker / VPS) — live fetch pipeline (fetch → scan → refresh)
# PythonAnywhere ignores these (wsgi.py forces scheduler off, /fetch → 501).
ENABLE_FETCH=true
FETCH_INTERVAL_MIN=15
FETCH_TFS=H1
FETCH_LIMIT=300
# CACHE_DIR=/data/cache
# RESULTS_DIR=/data/results

# Entry mode: mid (legacy 50% / open, manage at touch) | proximal (bull=OB high / bear=OB low)
ENTRY_MODE=mid
