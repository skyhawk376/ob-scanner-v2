# OANDA v20 practice API (optional)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Telegram (P4) — leave empty to force dry-run log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = never call Telegram API (writes data/results/telegram_dryrun.log)
TELEGRAM_DRY_RUN=true

# Start APScheduler with API (monitor + digests 07:45 / 14:15 Paris)
ENABLE_SCHEDULER=false

TZ=Europe/Paris

# Lifecycle sensitivity (P1)
# Soft reaction at 0.5R ON by default (better UX). Set false or SOFT_REACTION_R=0 to require +1R only.
ENABLE_SOFT_REACTION=true
SOFT_REACTION_R=0.5
REACTION_R=1.0
